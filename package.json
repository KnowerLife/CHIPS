{
  "name": "chips",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CHIPS — веб-игра по мотивам дворовой игры «Сотки/Фишки» (кэпсы).",
  "license": "MIT",
  "author": "KNOWER LIFE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnowerLife/CHIPS.git"
  },
  "homepage": "https://github.com/KnowerLife/CHIPS#readme",
  "bugs": {
    "url": "https://github.com/KnowerLife/CHIPS/issues"
  },
  "keywords": [
    "game",
    "phaser",
    "typescript",
    "vite",
    "sotki",
    "pogs",
    "caps",
    "telegram-mini-app",
    "multiplayer",
    "browser-game"
  ],
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:server": "node --test server/*.test.mjs",
    "smoke": "node scripts/smoke-online.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}

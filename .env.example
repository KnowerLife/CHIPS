# ─── CHIPS online service ────────────────────────────────────────────────────
# Copy to `.env` and fill in. With no BOT_TOKEN the server runs in DEV mode:
# mock payments are enabled and no Telegram calls are made.

# HTTP port the game server listens on (also serves the built client).
PORT=8787

# Telegram bot token from @BotFather. Leave empty for local development.
BOT_TOKEN=

# Bot username (without @) — used to build Mini App invite deep links.
BOT_USERNAME=

# Public HTTPS URL of this deployment (used inside the Mini App / share links).
WEBAPP_URL=

# Public base URL; on boot the server registers the Telegram webhook at
# <PUBLIC_URL>/api/telegram/webhook when BOT_TOKEN + a non-localhost URL are set.
PUBLIC_URL=

# Where the JSON store lives (accounts, orders). Mount a volume here in prod.
DATA_DIR=./server/data
